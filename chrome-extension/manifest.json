{
  "manifest_version": 3,
  "name": "SessionForge Import",
  "version": "1.3.1",
  "description": "Send the current tab's login to the SessionForge desktop app on this computer (localhost only)",
  "minimum_chrome_version": "103",
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:34567/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
